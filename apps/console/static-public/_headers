# Security headers for the hosted demo. connect-src lists every origin the browser may call: this site
# (/demo-snapshot.json, /proof.json) and two public NEAR mainnet RPCs for read-only chain data in the
# Real view (primary FastNEAR, fallback NEAR's RPC; both allow CORS). Any other request is refused.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://rpc.mainnet.fastnear.com https://rpc.mainnet.near.org; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
