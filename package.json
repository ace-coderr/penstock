{
  "name": "penstock",
  "private": true,
  "version": "0.1.0",
  "description": "Get paid by AI agents from any chain: an x402 paywall that settles in USDC on NEAR via NEAR Intents.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "demo": "tsx scripts/demo.ts",
    "dev": "tsx scripts/demo.ts --no-open",
    "proxy": "pnpm --filter @penstock/proxy start",
    "console": "pnpm --filter @penstock/console dev",
    "selftest": "tsx packages/selftest/src/cli.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @penstock/console typecheck",
    "lint": "eslint .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "buyer-mcp": "pnpm --filter @penstock/buyer-mcp start",
    "start:dry": "tsx --env-file-if-exists=.env scripts/demo.ts --mode dry",
    "start:live": "tsx --env-file=.env scripts/demo.ts --mode live --no-agent"
  },
  "dependencies": {
    "@penstock/core": "workspace:*",
    "@penstock/proxy": "workspace:*",
    "@penstock/buyer-mcp": "workspace:*",
    "@penstock/example-upstream-apis": "workspace:*",
    "@penstock/selftest": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
