# Penstock configuration. Copy to .env and edit. Never commit .env.

# demo | dry | live
#   demo: everything simulated, no network, no keys, no funds (default)
#   dry:  real 1Click dry quotes over the network; settlement simulated; no funds move
#   live: real 1Click quotes and status polling, real NEAR settlement; tiny amounts only
MODE=demo

# Proxy
PORT=4020
# Listen address. Defaults: 127.0.0.1 in demo/dry (simulated payments stay local), 0.0.0.0 in live.
HOST=
PUBLIC_URL=http://localhost:4020
CONSOLE_URL=http://localhost:4021
# Where the SQLite ledger and runtime keys are written
DATA_DIR=./data/runtime

# Secret used to MAC near-intents operation tokens. 32+ random bytes, hex or base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In demo mode a random per-run secret is used when this is empty. Required in live mode.
OPERATION_TOKEN_SECRET=
OPERATION_TOKEN_KEY_ID=k1

# Console admin token (protects /api/admin/*). Required in live mode.
ADMIN_TOKEN=

# Seller payout account on NEAR mainnet (must already exist and hold USDC storage)
SELLER_NEAR_ACCOUNT=

# 1Click Swap API (NEAR Intents): https://docs.near-intents.org/integration/distribution-channels/1click-api/about-1click-api
ONECLICK_BASE_URL=https://1click.chaindefuser.com
# Optional partner JWT from https://partners.near-intents.org. With it, 1Click uses the partner fee
# schedule instead of adding 0.25% to every quote, and confidential (shielded) quotes become
# available (they return HTTP 401 without it). Sent as the X-API-Key header. Never logged; never commit it.
ONECLICK_JWT=

# Standard x402 exact scheme on NEAR: an x402 facilitator (e.g. a fastnear/x402-facilitator instance)
FACILITATOR_URL=
FACILITATOR_API_KEY=

# Resale (live only): full-access key of SELLER_NEAR_ACCOUNT, used to pay upstream Penstock sellers
# for resale endpoints. Demo and dry use a simulated wallet.
RESALE_NEAR_KEY=

# Live proof: `pnpm live:check` and the one-off live payment (docs/LIVE-RUNBOOK.md).
# Use separate dev accounts and tiny amounts. Nothing here is needed in demo or dry mode.
# Hard cap in USD for any single real payment or swap the live scripts send (default 1).
LIVE_MAX_USD=1
# Payer wallet on Solana mainnet. Address: base58 public key (used as the refund address).
PAYER_SOLANA_ADDRESS=
# Payer secret key: base58 64-byte secret key, as exported by Phantom or Solflare.
# Never logged. Only the live scripts read it, and only to sign the deposit transfer.
PAYER_SOLANA_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Seller account key (ed25519:...), used once to register USDC storage for SELLER_NEAR_ACCOUNT.
# Optional: leave empty if storage is registered another way. Never logged.
SELLER_NEAR_PRIVATE_KEY=
NEAR_RPC_URL=https://rpc.mainnet.fastnear.com

# Sessions
SESSION_CAP_USD=5

# Shielded-payer routes (both off unless configured)
SHIELDED_CONFIDENTIAL_INTENTS=false
SHIELDED_AURORA_RPC_URL=

# Upstreams on loopback/private addresses: allowed in demo/dry, refused in live unless true
ALLOW_PRIVATE_UPSTREAMS=
# Only set true behind a reverse proxy you control (honours X-Forwarded-For)
TRUST_PROXY=false

# Logging: info | debug | silent
PENSTOCK_LOG=info

# ── Optional: other tools (empty = the default in brackets) ─────────────
# Local ports for `pnpm demo` and `pnpm serve:static` [4021, 4030, 4031, 4032]
CONSOLE_PORT=
UPSTREAM_PORT=
PREVIEW_PORT=
STATIC_PORT=
# Console dev server proxy target [http://localhost:4020]
PENSTOCK_PROXY_URL=
# Build-time site address for absolute Open Graph image URLs (public, not a secret) [relative]
SITE_URL=
# Buyer MCP server and `pnpm selftest` (packages/buyer-mcp/src/env.ts)
PENSTOCK_DIRECTORIES=
PENSTOCK_HOLDINGS=
PENSTOCK_SIMULATED=
# Live exact payments in USDC on NEAR by the buyer tools: account and full-access key. Never logged.
PENSTOCK_NEAR_ACCOUNT=
PENSTOCK_NEAR_KEY=
